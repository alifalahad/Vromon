# Vromon — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real credentials.

# --- Application ---
APP_ENV=development
APP_DEBUG=false

# --- Database ---
# SQLite (default for development):
DATABASE_URL=sqlite:///./vromon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vromon

# --- LLM (optional — system works without it) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Embeddings (optional — needed for RAG) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# --- Maps (optional) ---
MAPS_PROVIDER=

# --- Server ---
# For mobile device access, use your machine's local IP instead of localhost
# Find it with: ipconfig (Windows) or ifconfig (Mac/Linux)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
