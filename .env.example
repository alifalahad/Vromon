# Vromon — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real credentials.

# --- Application ---
APP_ENV=development
APP_DEBUG=false

# --- Database ---
# SQLite (default for development):
DATABASE_URL=sqlite:///./vromon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vromon

# --- LLM (optional — itinerary planning works without it; needed for /api/v1/rag/ask) ---
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# --- Embeddings (optional — without a key a dummy, NON-semantic provider is used) ---
# The same Gemini API key can be used here.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# --- Grounded RAG ---
# Minimum cosine similarity for a chunk to count as evidence. Calibrate with
# evaluation/rag_generation_eval.py --retrieval-only after changing embedding model.
RAG_MIN_SCORE=0.55
RAG_TOP_K=5

# --- CP-SAT itinerary optimizer (POST /api/v1/trips/{id}/generate?algorithm=cpsat) ---
# Deterministic work limit → the same request returns the same schedule.
OPTIMIZER_DETERMINISTIC_LIMIT=5.0
# Wall-clock safety cap in seconds.
OPTIMIZER_TIME_LIMIT_SECONDS=15
OPTIMIZER_WORKERS=8

# --- CORS ---
# Browser origins allowed to call the API (Expo web runs on :8081). Native apps are not affected.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# --- Admin ---
# Required as the X-Admin-Token header for POST /api/v1/rag/ingest when set.
# With APP_ENV=production and no token, admin endpoints are disabled.
ADMIN_TOKEN=

# --- Maps (optional) ---
MAPS_PROVIDER=

# --- Mobile app ---
# The mobile app's backend URL lives in mobile/.env (see mobile/.env.example).
