# Vromon Mobile — copy to mobile/.env (git-ignored) and adjust.
#
# Backend base URL (no /api/v1 suffix). Must start with EXPO_PUBLIC_ to reach app code.
#   Web preview / iOS Simulator on the same machine:  http://127.0.0.1:8000
#   Android Emulator:                                 http://10.0.2.2:8000
#   Physical phone on the same Wi-Fi:                 http://<your computer's LAN IP>:8000
#     macOS: ipconfig getifaddr en0   ·   Windows: ipconfig   ·   Linux: hostname -I
# Start the backend with --host 0.0.0.0 so the phone can reach it.
# Restart `npx expo start` after editing. Never put API keys here: EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
